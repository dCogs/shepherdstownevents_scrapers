BEGIN:VEVENT
UID:20260515T200000Z-1695fc59-11f8-5a3b-bb2e-2b52d06f9f21@ghost
DTSTAMP:20260510T081816Z
DTSTART:20260515T200000Z
DTEND:
SUMMARY:Ghost Tour!
LOCATION:Welcome Center at the Market House, 100 East German St, Shepherdstown
DESCRIPTION:Duration 1 hour and 30 minutes\nStroll through Shepherdstown with a costumed guide who leads you by candlelight from one haunted and historic location to the next.\n\nEasy 1 mile Walk. Dog-friendly!
CATEGORIES:History
ORGANIZATION:Shepherdstown Mystery Walks
URL:https://shepherdstownmysterywalks.com/
STATUS:CONFIRMED
SOURCE:shepherdstownmysterywalks.com/
SEQUENCE:0
END:VEVENT
